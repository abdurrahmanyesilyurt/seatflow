{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=booking;Username=booking;Password=booking",
    "Redis": "localhost:6380",
    "RabbitMq": "amqp://seatflow:seatflow@localhost:5672"
  },
  "RabbitMq": {
    "QueueName": "booking"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Booking": {
    "HoldTtl": "00:10:00",
    "PaymentTimeout": "00:02:00",
    "ExpiryScanInterval": "00:00:05",
    "MaxSeatsPerBooking": 8
  },
  "Auth": {
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration"
  }
}
