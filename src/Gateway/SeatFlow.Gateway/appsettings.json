{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DevIdentity": {
    "Enabled": true,
    "Admins": [ "admin@seatflow.local" ],
    "TokenLifetime": "01:00:00"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/catalog/{**rest}", "Methods": [ "GET" ] }
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "Order": 10,
        "Match": { "Path": "/api/catalog/{**rest}" }
      },
      "seat-map": {
        "ClusterId": "booking",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/bookings/events/{eventId}/seats", "Methods": [ "GET" ] }
      },
      "bookings": {
        "ClusterId": "booking",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Order": 10,
        "Match": { "Path": "/api/bookings/{**rest}" }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/payments/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "catalog": { "Destinations": { "primary": { "Address": "http://catalog:8080" } } },
      "booking": { "Destinations": { "primary": { "Address": "http://booking:8080" } } },
      "payment": { "Destinations": { "primary": { "Address": "http://payment:8080" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://notification:8080" } } }
    }
  }
}
